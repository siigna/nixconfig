+// normalizeModelID maps gateway-style IDs such as OpenRouter's
+// "anthropic/claude-opus-5.5" onto the native "claude-opus-5-5" form.
+func normalizeModelID(model string) string {
+	if i := strings.LastIndexByte(model, '/'); i >= 0 {
+		model = model[i+1:]
+	}
+	return strings.ReplaceAll(model, ".", "-")
+}
